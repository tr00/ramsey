    "guard_contents": "# Local build-only guard: preserve the existing generated source-tree headers.\n# SoPlex is enabled by the genuine WITHSOPLEX target definition and libsoplex link.\n# Intercept only RoundingSat's two metadata queries; no git command is executed.\nmacro(execute_process)\n  if(\"${ARGV0}\" STREQUAL \"COMMAND\" AND \"${ARGV1}\" STREQUAL \"git\")\n    if(\"${ARGV2}\" STREQUAL \"rev-parse\" AND \"${ARGV3}\" STREQUAL \"--abbrev-ref\" AND \"${ARGV4}\" STREQUAL \"HEAD\")\n      set(GIT_BRANCH \"master\")\n    elseif(\"${ARGV2}\" STREQUAL \"log\" AND \"${ARGV3}\" STREQUAL \"-1\" AND \"${ARGV4}\" STREQUAL \"--format=%h\")\n      set(GIT_COMMIT_HASH \"d4edbf7\")\n    else()\n      message(FATAL_ERROR \"Unexpected git command in immutable-source build: ${ARGV}\")\n    endif()\n  else()\n    _execute_process(${ARGV})\n  endif()\nendmacro()\n\nfunction(configure_file input output)\n  if(\"${output}\" STREQUAL \"${PROJECT_SOURCE_DIR}/src/CMakeConfig.hpp\" OR\n     \"${output}\" STREQUAL \"${PROJECT_SOURCE_DIR}/src/version.hpp\")\n    get_filename_component(header_name \"${output}\" NAME)\n    set(checked_output \"${PROJECT_BINARY_DIR}/soplex-build-record/${header_name}.checked\")\n    _configure_file(\"${input}\" \"${checked_output}\" ${ARGN})\n    file(READ \"${output}\" existing_header)\n    file(READ \"${checked_output}\" configured_header)\n    if(NOT \"${existing_header}\" STREQUAL \"${configured_header}\")\n      message(FATAL_ERROR \"Configuration would modify preserved vendored header: ${output}\")\n    endif()\n    message(STATUS \"Verified unchanged vendored generated header: ${header_name}\")\n  else()\n    _configure_file(\"${input}\" \"${output}\" ${ARGN})\n  endif()\nendfunction()\n",
